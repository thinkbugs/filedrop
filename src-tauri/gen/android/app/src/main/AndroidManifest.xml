<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS peer discovery needs raw multicast RX; without this lock the
         Wi-Fi driver silently drops the 224.0.0.251:5353 responses. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Keeps the receive server (and its sockets) alive with the screen off,
         matching the desktop build's always-on receiving. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ limits a dataSync service to 6 hours in any 24, after which it
         is stopped and the device disappears from the LAN again. Receiving is this
         app's whole job and has to stay up, so it asks for specialUse instead;
         dataSync is still declared for the 13-and-below path in ServerService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: inbound file/message notifications need this at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 9 and below have no MediaStore hand-out for a new shared file,
         so the receive path writes by path and needs this at runtime. Above 9 the
         platform refuses the permission entirely and StorageBridge asks MediaStore
         for the path instead. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Doze suspends network access for every app that is not exempted, even
         with a foreground service and a Wi-Fi lock; without the exemption the
         phone answers pings and refuses every connection once the screen has
         been off for a while. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.filedrop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Files shared from the gallery or a file manager land here and are
                 copied into the app's share inbox for the send sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Started/stopped by the Rust side together with the transfer server.
             Holds the multicast + partial wake locks for as long as receiving is
             on, and carries the persistent notification. -->
        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <!-- What the specialUse service is actually for, as the platform asks
                 for it. Ignored below API 31. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the LAN file-transfer server, mDNS discovery and the Wi-Fi multicast lock listening while the app is in the background, so other devices on the network can reach this phone at any time." />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
